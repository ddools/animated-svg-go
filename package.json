{
  "name": "animated-svg-go",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "corpus": "rm -rf tests/corpus/report && (playwright test -c playwright.corpus.config.ts || true) && node tests/corpus/summarise.mjs",
    "parity": "playwright test -c playwright.parity.config.ts",
    "lint": "eslint . && svelte-check && tsc --noEmit",
    "ext:build": "node extension/build.mjs",
    "ext:smoke": "node extension/build.mjs && node extension/smoke.mjs",
    "ext:package": "node extension/build.mjs && node extension/package.mjs"
  },
  "devDependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "1.90.0",
    "astro": "^7.3.8",
    "daisyui": "^5.7.47",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dompurify": "3.4.17",
    "gifenc": "1.0.3",
    "idb-keyval": "6.3.0",
    "mediabunny": "1.60.0",
    "svgo": "^4.1.0",
    "zod": "4.6.5"
  }
}
