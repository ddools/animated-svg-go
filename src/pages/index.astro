---
import '../styles/global.css';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Animated SVG GO</title>
  </head>
  <body class="grid min-h-screen place-items-center">
    <main class="text-center">
      <h1 class="text-4xl font-bold">Animated SVG GO</h1>
      <p class="py-4">Drop in an SVG. Make it move. Export it.</p>
      <a class="btn btn-primary" href="/editor">Open the editor</a>
    </main>
  </body>
</html>
